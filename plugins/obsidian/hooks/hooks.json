{
  "description": "Obsidian vault guard — warns before renaming or deleting Markdown files to protect wikilinks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/wikilink_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
